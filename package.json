{
  "name": "mycimmena",
  "version": "1.0.0",
  "private": true,
  "description": "App Android personale per tenere traccia di film e serie visti e da vedere.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "serve": "node tools/serve.js",
    "sync": "cap sync android",
    "open": "cap open android",
    "apk:debug": "cap sync android && cd android && gradlew assembleDebug",
    "apk:release": "cap sync android && cd android && gradlew assembleRelease && cd .. && node tools/release.js",
    "set-version": "node tools/version.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "fake-indexeddb": "^6.2.8"
  }
}
